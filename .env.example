# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=change_me

# AI-модель для анализа фото (пример под Anthropic; замени под свой выбор)
AI_API_KEY=your_ai_api_key_here
AI_MODEL=claude-sonnet-4-6

# Приложение
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# Публичный URL прода (нужен для настройки Telegram webhook)
PUBLIC_BASE_URL=https://your-app.onrender.com
